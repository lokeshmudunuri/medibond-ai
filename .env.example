# CareBond AI — Environment Configuration Template
# NOTE: Do NOT put real secrets or private API keys in this file.
# Copy this file to .env for local configuration if needed.

# Hugging Face Hub (Optional, for downloading gated or private models)
HF_TOKEN=

# Gemini / Cloud LLM API Key (Optional fallback, prototype defaults to 100% offline llama.rn)
GEMINI_API_KEY=

# Application Environment (development | staging | production)
APP_ENV=development

# Diagnostics & Logging (true | false)
ENABLE_VERBOSE_LOGS=false
